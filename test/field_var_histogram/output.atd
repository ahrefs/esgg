(* Generated by esgg output from field_var_histogram/query.json based on field_var_histogram/mapping.json *)
type reason <ocaml from="Esgg_shared"> = abstract
type failure <ocaml from="Esgg_shared"> = abstract
type _shards <ocaml from="Esgg_shared"> = abstract
type 'key doc_count = { key: 'key; doc_count: int }
type 'a buckets = { buckets: 'a list }
type int_as_float =
  float wrap <ocaml t="int" wrap="int_of_float" unwrap="float_of_int">
type 'a value_agg' = { value: 'a }
type 'a value_agg =
  'a value_agg' wrap
    <ocaml
       t="'a" wrap="fun { value; } -> value" unwrap="fun value -> { value; }">
type basic_json <ocaml module="Json" t="t"> = abstract
type hit = { _id: string; _source: basic_json }
type hits = { total: int; ~hits: hit list }
type aggregations = { distribution: float doc_count buckets }
type result = {
  hits: hits;
  ?_shards: _shards nullable;
  aggregations: aggregations
}

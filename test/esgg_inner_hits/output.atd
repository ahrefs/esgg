(* Generated by esgg output from esgg_inner_hits/query.json based on esgg_inner_hits/mapping.json *)
type 'key doc_count = { key: 'key; doc_count: int }
type 'a buckets = { buckets: 'a list }
type int_as_float =
  float wrap <ocaml t="int" wrap="int_of_float" unwrap="float_of_int">
type 'a value_agg' = { value: 'a }
type 'a value_agg =
  'a value_agg' wrap
    <ocaml
       t="'a"
       wrap="fun ({ value; } : _ value_agg') -> value"
       unwrap="fun value -> ({ value; } : _ value_agg')">
type basic_json <ocaml module="Json" t="t"> = abstract
type total_relation = [ Eq <json name="eq"> | Gte <json name="gte"> ]
type total_hits = { value: int; relation: total_relation }
type comment = {
  author: string wrap <ocaml module="Comments.Author">;
  text: string wrap <ocaml module="Comments.Text">
}
type _source = {
  title: string wrap <ocaml module="Title">;
  ~comments: comment list
}
type _nested = { field: string; offset: int }
type hit = { _id: string; _nested: _nested; _source: comment }
type hits = { total: total_hits; ~hits: hit list }
type comments = { hits: hits }
type inner_hits = { comments: comments }
type hit1 = {
  _id: string;
  _source: _source;
  ?inner_hits: inner_hits nullable
}
type hits1 = { total: total_hits; ~hits: hit1 list }
type reason = { type_ <json name="type">: string; ?reason: string nullable }
type failure = {
  reason: reason;
  ?index: string nullable;
  ?node: string nullable;
  ?shard: int nullable;
  ?status: string nullable
}
type _shards = {
  total: int;
  successful: int;
  skipped: int;
  failed: int;
  ?failures: failure list nullable
}
type result = {
  ?took: int nullable;
  hits: hits1;
  ?_shards: _shards nullable
}

(* Generated by esgg output from numeric_types/query.json based on numeric_types/mapping.json *)
type 'key doc_count = { key: 'key; doc_count: int }
type 'a buckets = { buckets: 'a list }
type int_as_float =
  float wrap <ocaml t="int" wrap="int_of_float" unwrap="float_of_int">
type 'a value_agg' = { value: 'a }
type 'a value_agg =
  'a value_agg' wrap
    <ocaml
       t="'a" wrap="fun { value; } -> value" unwrap="fun value -> { value; }">
type basic_json <ocaml module="Json" t="t"> = abstract
type _source = {
  views: int wrap <ocaml module="Views">;
  rank: int wrap <ocaml module="Rank">;
  flags: int wrap <ocaml module="Flags">;
  ratio: float wrap <ocaml module="Ratio">;
  price: float wrap <ocaml module="Price">;
  count: int wrap <ocaml module="Count">;
  name: string wrap <ocaml module="Name">
}
type hit = { _id: string; _source: _source }
type hits = { total: int; ~hits: hit list }
type reason = { type_ <json name="type">: string; ?reason: string nullable }
type failure = {
  reason: reason;
  ?index: string nullable;
  ?node: string nullable;
  ?shard: int nullable;
  ?status: string nullable
}
type _shards = {
  total: int;
  successful: int;
  skipped: int;
  failed: int;
  ?failures: failure list nullable
}
type aggregations = {
  total_views: int_as_float value_agg;
  avg_price: float nullable value_agg
}
type result = {
  ?took: int nullable;
  hits: hits;
  ?_shards: _shards nullable;
  aggregations: aggregations
}

(* Generated by esgg output from range_params/query.json based on range_params/mapping.json *)
type 'key doc_count = { key: 'key; doc_count: int }
type 'a buckets = { buckets: 'a list }
type int_as_float =
  float wrap <ocaml t="int" wrap="int_of_float" unwrap="float_of_int">
type 'a value_agg' = { value: 'a }
type 'a value_agg =
  'a value_agg' wrap
    <ocaml
       t="'a"
       wrap="fun ({ value; } : _ value_agg') -> value"
       unwrap="fun value -> ({ value; } : _ value_agg')">
type basic_json <ocaml module="Json" t="t"> = abstract
type total_relation = [ Eq <json name="eq"> | Gte <json name="gte"> ]
type total_hits' = { value: int; relation: total_relation }
type total_hits =
  total_hits' wrap
    <ocaml
       t="[ `Eq of int | `Gte of int ]"
       wrap=
         "fun ({ value; relation } : total_hits') -> (match relation with `Eq -> `Eq value | `Gte -> `Gte value)"
       unwrap=
         "fun total -> (match total with `Eq value -> ({ value; relation = `Eq } : total_hits') | `Gte value -> ({ value; relation = `Gte } : total_hits'))">
type _source = {
  content: string wrap <ocaml module="Content">;
  words: int wrap <ocaml module="Words">;
  publish_time: string wrap <ocaml module="Publish_time">
}
type hit = { _id: string; _source: _source }
type hits = { total: total_hits; ~hits: hit list }
type reason = { type_ <json name="type">: string; ?reason: string nullable }
type failure = {
  reason: reason;
  ?index: string nullable;
  ?node: string nullable;
  ?shard: int nullable;
  ?status: string nullable
}
type _shards = {
  total: int;
  successful: int;
  skipped: int;
  failed: int;
  ?failures: failure list nullable
}
type result = { ?took: int nullable; hits: hits; ?_shards: _shards nullable }
